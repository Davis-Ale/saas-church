generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  members   Member[]
  cells     Cell[]
  paths     Path[]
  ministries Ministry[]
  events    Event[]
  transactions Transaction[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id])
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  birthDate       String?
  address         String?
  cellId          String?
  cell            Cell?    @relation(fields: [cellId], references: [id])
  serviceApproved Boolean  @default(true)
  status          String
  churchId        String
  church          Church   @relation(fields: [churchId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cell {
  id          String   @id @default(uuid())
  name        String
  leaderId    String?
  address     String?
  meetingDay  String?
  meetingTime String?
  status      String
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Path {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int?
  status      String
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ministry {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?
  startDate    String
  endDate      String?
  price        Float?
  maxAttendees Int?
  status       String
  churchId     String
  church       Church   @relation(fields: [churchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  amount      Float
  description String
  categoryId  String?
  date        String
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
